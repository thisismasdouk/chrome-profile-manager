{
  "manifest_version": 3,
  "name": "Profile Manager: Bulk Delete Chrome Profiles",
  "short_name": "Profile Manager",
  "version": "1.0.0",
  "description": "Delete multiple Chrome profiles at once. See every profile with its email, last use and size, then remove many in one click.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Profile Manager: delete Chrome profiles in bulk",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://thisismasdouk.github.io/chrome-profile-manager/"
}